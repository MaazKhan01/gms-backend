{
  "AppName": "GMS",
  "FrontendUrl": "http://localhost:5173",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://gms-wine.vercel.app"
  ],
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=olympic-gms;Trusted_Connection=True;TrustServerCertificate=True",
  },

  "Seed": {
    "AdminEmail": "admin@gms.local",
    "AdminUserName": "admin",
    "AdminPassword": "Admin@123!"
  },

  "Authentication": {
    "Jwt": {
      "JwtSecretKey": "<MOVE_TO_USER_SECRETS_OR_ENVIRONMENT_VARIABLE>",
      "Issuer": "https://localhost:7001",
      "Audience": "http://localhost:5173",
      "ExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 30
    }
  },

  "AzureCommunicationServiceConfig": {
    "COMMUNICATION_SERVICES_CONNECTION_STRING": "<MOVE_TO_SECRET_STORE>",
    "EmailSenderInfo": "DoNotReply@fc5a9322-d1ce-46bf-b827-9bcc11c14844.azurecomm.net"
  },

  "AzureStorage": {
    "BlobConnectionString": "<MOVE_TO_SECRET_STORE>",
    "BlobContainerName": "media",
    "IdentifierName": "eventfulsignedidentifier"
  },

  "Caching": {
    "Redis": {
      "ConnectionString": "",
      "RedisCacheExpiryMinutes": {
        "Default": 60
      }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}